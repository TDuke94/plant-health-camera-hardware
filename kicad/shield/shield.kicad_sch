  (text "Rev A shield for NUCLEO-N657X0-Q. Pins per UM3417 Table 20 (CN3, CN15). All shield signals are 3.3 V digital I/O." (at 20.32 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 9240aa0c-d79f-4fbc-9ad1-8dfb50976008))
  (text "PC3/PC4 are used on the Nucleo (ST-LINK PD CC lines); the D-pad avoids them." (at 20.32 25.40 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 460272d7-d33d-4453-a7c6-2919a5543c39))
  (text "Power: 5 V from the Nucleo (CN8 USB-C), local 3V3 LDO" (at 86.36 30.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid c96e1295-507c-4b53-aa9c-f556279403b7))
  (text "I2C1: ATECC608B 0x60, LSM6DSO 0x6A, Qwiic breakouts. Fit R1/R2 only if the Nucleo has no I2C1 pull-ups." (at 86.36 83.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 345d2cda-2be7-43ff-817c-54b19539c0b7))
  (text "microSD, SPI mode on SPI5 (shared with the display)" (at 152.40 30.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 4c6dd9d6-42db-4e78-ae97-fa9c115ed5df))
  (text "Display: off-the-shelf ST7789-class SPI module; BL drives the module's backlight input" (at 152.40 106.68 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 911676cd-e11a-4d0b-8902-89860e7ace64))
  (text "GNSS: dual-band breakout with raw output; both 5 V and 3V3 offered" (at 152.40 149.86 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 51c129f2-0961-42d1-9414-a6bc8fd85f7b))
  (text "Buttons: active low, MCU internal pull-ups, firmware debounce" (at 281.94 40.64 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid e0b6d7bd-f035-40df-bad9-3a72c7169879))
  (text "Flash: (5 V - Vf 3.0 V) / 2.8 R = ~0.7 A pulses under 50 ms; C9 supplies the peak" (at 281.94 147.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid a4a56f8f-7ac5-43a8-be8f-1741773613d0))
  (text "NIR LEDs: footprints only, not fitted on rev A" (at 355.60 40.64 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 2f2052c4-abea-4c4d-99c8-fc2076ec1da4))
